{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git add:*)"
        ],
        "ask": [
            "Bash(gh pr create:*)",
            "Bash(git commit:*)"
        ],
        "deny": [
            "Edit(.claude/settings.json)",
            "Read(*.env)",
            "Write(*.env)",
            "Edit(*.env)",
            "Bash(rm:*)",
            "Bash(curl:*)",
            "Bash(git push *)",
            "Bash(rm -rf *)",
            "Bash(git push --force *)",
            "Bash(git reset --hard *)"
        ],
        "defaultMode": "default"
    }
}